# =============================================================================
# AI Lead Intelligence Platform — Backend Environment Configuration
# =============================================================================
# Copy this file to backend/.env and fill in real values.
# NEVER commit the actual .env file to version control.
#
# Generate secrets with: openssl rand -hex 32
# =============================================================================

# ── Application ─────────────────────────────────────────────────────────────
# Environment mode: development | testing | staging | production
ENVIRONMENT=development

# Enable debug mode (detailed errors, auto-reload). Set to false in production.
DEBUG=true

# Public URLs used for CORS and links
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Secret key for signing sessions/tokens. CHANGE THIS in production.
# Generate: openssl rand -hex 32
SECRET_KEY=generate-with-openssl-rand-hex-32

# ── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
# Credentials must match POSTGRES_USER/POSTGRES_PASSWORD in docker-compose.yml
POSTGRES_USER=leadplatform
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=leadplatform

# Full connection string (constructed from above if using docker-compose)
DATABASE_URL=postgresql+asyncpg://leadplatform:change-me-in-production@postgres:5432/leadplatform

# Log all SQL queries (dev only)
DATABASE_ECHO=false

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200

# ── Auth (JWT) ──────────────────────────────────────────────────────────────
# Signing secret. MUST be changed in production.
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OAuth — Google ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── AI Providers ─────────────────────────────────────────────────────────────
# OpenAI / compatible API key (LongCat, OpenAI, etc.)
OPENAI_API_KEY=your-openai-key-here
OPENAI_API_BASE=https://api.longcat.chat/openai/v1

# Alternative providers (optional)
ANTHROPIC_API_KEY=your-anthropic-key-here
GOOGLE_AI_API_KEY=your-google-ai-key-here

# Default models
AI_DEFAULT_MODEL=LongCat-2.0
AI_SMART_MODEL=LongCat-2.0
AI_EMBEDDING_MODEL=openai/text-embedding-3-small

# ── Scraping ────────────────────────────────────────────────────────────────
# Proxy for outbound scraping requests (optional)
PROXY_URL=

# 2Captcha or similar service key (optional)
CAPTCHA_API_KEY=your-captcha-key-here

# Concurrency and politeness
SCRAPING_MAX_CONCURRENT=5
SCRAPING_DEFAULT_DELAY=2.0

# ── Email / SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=your-sendgrid-key-here

# ── WhatsApp (Meta Business API) ─────────────────────────────────────────────
WHATSAPP_API_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ── Enrichment APIs ──────────────────────────────────────────────────────────
HUNTER_API_KEY=your-hunter-key-here
APOLLO_API_KEY=your-apollo-key-here
CLEARBIT_API_KEY=your-clearbit-key-here
PAGESPEED_API_KEY=your-pagespeed-key-here

# ── MinIO (S3-compatible storage) ────────────────────────────────────────────
# Must match MINIO_ROOT_USER/MINIO_ROOT_PASSWORD in docker-compose.yml
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-production
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=leads

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── i18n ────────────────────────────────────────────────────────────────────
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=["es","en"]
